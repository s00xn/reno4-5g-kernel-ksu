diff --git a/lib/string.c b/lib/string.c
index edf4907e..2f2eee93 100644
--- a/lib/string.c
+++ b/lib/string.c
@@ -234,6 +234,19 @@ ssize_t strscpy(char *dest, const char *src, size_t count)
 	return -E2BIG;
 }
 EXPORT_SYMBOL(strscpy);
+
+/* 5.x API, backported for KernelSU */
+void strscpy_pad(char *dest, const char *src, size_t count)
+{
+	ssize_t written;
+
+	written = strscpy(dest, src, count);
+	if (written < 0 || written == count)
+		return;
+
+	memset(dest + written, 0, count - written);
+}
+EXPORT_SYMBOL(strscpy_pad);
 #endif
 
